# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables — copy to .env.local and fill in values.
# NEVER commit .env.local. This file contains placeholders only.
# NEXT_PUBLIC_ variables are embedded at build time. Do not store secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API. Must end in /api.
# Set this BEFORE running `npm run build` — it is fixed at build time.
# Required. Must match the backend origin (scheme, hostname, port) exactly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Set to true to use the in-memory mock API instead of the real backend.
# For UI development only. Default: false.
NEXT_PUBLIC_USE_MOCK=false
