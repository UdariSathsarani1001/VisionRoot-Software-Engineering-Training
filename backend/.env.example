# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — copy to .env and fill in real values locally.
# This file contains placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# Port the backend API listens on. Optional — defaults to 4000.
PORT=4000

# Application environment. Must be: development | production | test
NODE_ENV=development

# PostgreSQL connection string for the application database.
# Required. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# PostgreSQL connection string for the test database.
# Required only when running tests. Must contain "test" in the database name
# and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME_test

# Origin the browser frontend is served from.
# Must match the frontend URL exactly (scheme, hostname and port).
# Required in production — must not be "*".
# Optional in development — defaults to http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# Minimum log level. Optional — defaults to info.
# Allowed values: trace | debug | info | warn | error | silent
LOG_LEVEL=info
