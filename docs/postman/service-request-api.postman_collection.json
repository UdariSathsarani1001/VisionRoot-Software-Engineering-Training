{
  "info": {
    "name": "Service Request API",
    "description": "End-to-end collection for the Service Request Management System API. Run requests in order — the Create Request step sets the `requestId` variable used by subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('No stack trace', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "POST /requests — valid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test request\",\n  \"description\": \"Created by the Postman collection — safe to delete.\",\n  \"category\": \"IT\",\n  \"priority\": \"MEDIUM\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Status field is OPEN', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('OPEN');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});",
                  "// Save the id for subsequent requests",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set('requestId', id);",
                  "console.log('Created request id:', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /requests — empty title",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"description\": \"Missing title test.\",\n  \"category\": \"IT\",\n  \"priority\": \"LOW\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "pm.test('details contains title error', () => {",
                  "  const details = pm.response.json().error.details;",
                  "  pm.expect(details.some(d => d.field === 'title')).to.be.true;",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests?status=OPEN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/requests?status=OPEN",
              "query": [{ "key": "status", "value": "OPEN" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results have status OPEN', () => {",
                  "  pm.response.json().forEach(r => pm.expect(r.status).to.eql('OPEN'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests?status=DONE — invalid filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/requests?status=DONE",
              "query": [{ "key": "status", "value": "DONE" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct id returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('requestId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests/999999 — not found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /requests/abc — invalid id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/:id/status — to IN_PROGRESS",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status field is IN_PROGRESS', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');",
                  "});",
                  "pm.test('updated_at is present', () => {",
                  "  pm.expect(pm.response.json().updated_at).to.be.a('string');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/:id/status — skip to CLOSED",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_TRANSITION', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/:id/status — same status (IN_PROGRESS again)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_TRANSITION', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_TRANSITION');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/:id/status — invalid status value",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/999999/status — not found",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/999999/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});",
                  "pm.test('No stack trace', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('at ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /requests/abc/status — invalid id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/abc/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
